# Values must be provided as environment variables. This file is a setup reference,
# not automatically loaded. The native dock supplies these values on launch.
YOUTUBE_CLIENT_ID=your-desktop-client.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-desktop-client-secret
BRIDGE_PORT=17865
# Generate a fresh 32-byte random hex token for manual development launches.
BRIDGE_TOKEN=
# Optional explicit local data folder:
# BRIDGE_DATA=C:\Users\you\AppData\Local\obs-unified-chat
